{
  "name": "antigravity-account-switcher",
  "displayName": "Antigravity Account Switcher",
  "description": "Visual multi-account switcher and profile manager embedded directly in Antigravity IDE, synchronized across Antigravity 2.0 Desktop and the CLI.",
  "version": "1.8.1",
  "license": "MIT",
  "icon": "assets/icon.png",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "publisher": "antigravity-community",
  "repository": {
    "type": "git",
    "url": "https://github.com/ismaelsoilet/antigravity-account-switcher.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "AI"
  ],
  "keywords": [
    "antigravity",
    "gemini",
    "account",
    "profile",
    "switcher",
    "google-antigravity",
    "auth"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node tests/test_token_manager.js && python3 -m unittest discover -s tests -v",
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "configuration": {
      "title": "Antigravity Account Switcher",
      "properties": {
        "antigravityAccountSwitcher.preferredStore": {
          "type": "string",
          "enum": [
            "standaloneToken",
            "cliToken"
          ],
          "enumDescriptions": [
            "Prefer the Antigravity IDE/Desktop standalone token when stores disagree.",
            "Prefer the Antigravity CLI token when stores disagree."
          ],
          "default": "standaloneToken",
          "description": "Which token store wins when more than one account is present. Conflicts are always reported instead of switching automatically."
        },
        "antigravityAccountSwitcher.pollIntervalMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "How often to poll token files for changes. Polling is required because file watch events are unreliable on /mnt/c (WSL)."
        }
      }
    },
    "commands": [
      {
        "command": "antigravity-account-switcher.switch",
        "title": "Antigravity: Switch Account / Profile",
        "category": "Antigravity"
      },
      {
        "command": "antigravity-account-switcher.save",
        "title": "Antigravity: Snapshot Current Session as Profile",
        "category": "Antigravity"
      },
      {
        "command": "antigravity-account-switcher.login",
        "title": "Antigravity: Sign In to New Google Account",
        "category": "Antigravity"
      },
      {
        "command": "antigravity-account-switcher.diagnostics",
        "title": "Antigravity: Show Account Switcher Diagnostics",
        "category": "Antigravity"
      },
      {
        "command": "antigravity-account-switcher.doctor",
        "title": "Antigravity: Run Account Switcher Doctor",
        "category": "Antigravity",
        "icon": "$(heart)"
      },
      {
        "command": "antigravity-account-switcher.refreshDashboard",
        "title": "Antigravity: Refresh Accounts Dashboard",
        "category": "Antigravity",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravity-account-switcher.showQuota",
        "title": "Antigravity: Show Quota",
        "category": "Antigravity",
        "icon": "$(pulse)"
      },
      {
        "command": "antigravity-account-switcher.switchToProfile",
        "title": "Antigravity: Switch to Profile",
        "category": "Antigravity"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravityAccountSwitcher",
          "title": "Antigravity Accounts",
          "icon": "assets/activity.svg"
        }
      ]
    },
    "views": {
      "antigravityAccountSwitcher": [
        {
          "id": "antigravityAccountSwitcher.dashboard",
          "name": "Accounts",
          "contextualTitle": "Antigravity Accounts"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "antigravityAccountSwitcher.dashboard",
        "contents": "No saved accounts yet.\n[Sign In](command:antigravity-account-switcher.login)\n[Save Current Session](command:antigravity-account-switcher.save)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravity-account-switcher.refreshDashboard",
          "when": "view == antigravityAccountSwitcher.dashboard",
          "group": "navigation"
        },
        {
          "command": "antigravity-account-switcher.showQuota",
          "when": "view == antigravityAccountSwitcher.dashboard",
          "group": "navigation"
        },
        {
          "command": "antigravity-account-switcher.doctor",
          "when": "view == antigravityAccountSwitcher.dashboard",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "antigravity-account-switcher.switchToProfile",
          "when": "false"
        }
      ]
    }
  }
}
